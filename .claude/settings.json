{
  "permissions": {
    "allow": [
      "Bash(php artisan:*)",
      "Bash(composer:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx shadcn@latest:*)",
      "Bash(npx prettier:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(php.bat:*)",
      "Bash(composer.bat:*)",
      "Bash(php.bat vendor/bin/pint:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-on-stop.sh",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
