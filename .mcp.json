{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "playwright": {
            "type": "stdio",
            "command": "node",
            "args": [
                "node_modules/@playwright/mcp/cli.js"
            ],
            "env": {}
        }
    }
}
